# Chunk 1: basics 1
#1. Creating a sequence of numbers from 100 to 333, increasing by 3
seq <- seq(100, 333, 3)
seq
#2. Calculating the mean of this sequence
seq_mean <- mean(seq)
seq_mean
#3. Calculating the standard deviation of this sequence
seq_sd <- sd(seq)
seq_sd
#4. Calculating and displaying (mean - standard deviation) and (mean + standard deviation)
seq_mean - seq_sd
seq_mean + seq_sd
